{
  "manifest_version": 3,
  "name": "QuickComment",
  "version": "0.7.0",
  "description": "Generates 3 short comment options for any LinkedIn post, with knobs for size, attitude and style. Powered by Claude.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "QuickComment settings",
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/feed/*",
        "https://www.linkedin.com/feed",
        "https://www.linkedin.com/posts/*"
      ],
      "js": ["config.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
